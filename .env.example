# GLOW VAI Environment Variables Example
# Copy this file to .env.local for local development

# Resend API key and webhook secret
RESEND_API_KEY=re_123456789_abcdefg
RESEND_WEBHOOK_SECRET=whsec_abcdef123456

# Sending identity configuration
EMAIL_FROM_TRANSACTIONAL="GLOW VAI <hello@send.glowvai.in>"
EMAIL_FROM_MARKETING="GLOW VAI <tips@news.glowvai.in>"
EMAIL_REPLY_TO="contact@glowvai.in"

# Internal team notification recipients (comma separated)
TEAM_NOTIFY_EMAIL="team@glowvai.in"

# Secret key for unsubscribe tokens (32+ bytes)
UNSUBSCRIBE_SECRET=glowvai_unsubscribe_secret_32bytes_change_in_prod

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GA_API_SECRET=your_ga4_measurement_protocol_api_secret

# Apps Script to Next.js HMAC secret
INTERNAL_WEBHOOK_SECRET=glowvai_internal_webhook_secret_key_2026

# Google Sheets Apps Script Web App URL and Secret
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec
SHEETS_SECRET=glowvai_sheets_secret_key

# Feature flags
LEAD_ALERTS=true
REVIEW_EMAILS=true

# Scheduled cron job secret
CRON_SECRET=glowvai_cron_secret_key_2026

# Shop (/shop) Firebase web config for project glowvai-38bde (Firebase console > Project settings > Your apps).
# Required: the shop stops with an error naming any that are missing, and a Vercel production build fails without them.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=glowvai-38bde.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=glowvai-38bde
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
# Optional
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Skin-scan backend (CNN /predict). NEXT_PUBLIC_RENDER_API_URL defaults to the hosted backend.
# NEXT_PUBLIC_BACKEND_API_URL is an extra backend tried first; in development it defaults to http://localhost:4000.
NEXT_PUBLIC_RENDER_API_URL=
NEXT_PUBLIC_BACKEND_API_URL=

# Shared with the GlowVai admin panel (same value in both Vercel projects). Signs refund requests to
# /api/shop/internal/refund. 32+ random characters, for example: openssl rand -hex 32
INTERNAL_API_SECRET=

# Rider (delivery partner) web app: signs the rider session cookie and seeds the delivery-code vault key. Set only in the
# shop's Vercel project, Production and Preview. Never commit a value. 32+ random characters: openssl rand -hex 32
RIDER_SESSION_SECRET=

