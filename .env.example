# GLOW VAI Environment Variables Example
# Copy this file to .env.local for local development

# Public site URL. Required for production builds (sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://glowvai.in

# Resend API key and webhook secret
RESEND_API_KEY=re_123456789_abcdefg
RESEND_WEBHOOK_SECRET=whsec_abcdef123456

# Sending identity configuration
EMAIL_FROM_TRANSACTIONAL="GLOW VAI <hello@send.glowvai.in>"
EMAIL_FROM_MARKETING="GLOW VAI <tips@news.glowvai.in>"
EMAIL_REPLY_TO="contact@glowvai.in"

# Internal team notification recipients (comma separated)
TEAM_NOTIFY_EMAIL="team@glowvai.in"

# Secret key for unsubscribe tokens (32+ bytes)
UNSUBSCRIBE_SECRET=glowvai_unsubscribe_secret_32bytes_change_in_prod

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GA_API_SECRET=your_ga4_measurement_protocol_api_secret

# Apps Script to Next.js HMAC secret
INTERNAL_WEBHOOK_SECRET=glowvai_internal_webhook_secret_key_2026

# Google Sheets Apps Script Web App URL and Secret
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec
SHEETS_SECRET=glowvai_sheets_secret_key

# Feature flags
LEAD_ALERTS=true
REVIEW_EMAILS=true

# Scheduled cron job secret
CRON_SECRET=glowvai_cron_secret_key_2026
